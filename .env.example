# Copy to .env and adjust. Everything is optional; these are the defaults.
# Settings saved in the UI (data/settings.json) take precedence over the model values below.

# --- Web server ---
# HEARTH_PORT=4545               # local default. Use 8070 behind Cloudflare Tunnel (see docs/deploy.md)
# HEARTH_HOST=localhost          # loopback only (IPv4 + IPv6): Hearth has no login and can run commands
#                                # For the tunnel, 127.0.0.1 is enough; cloudflared on this PC connects to localhost.
# HEARTH_DATA_DIR=./data          # database, settings, user skills
# HEARTH_PROJECTS_DIR=C:\Users\me\HearthProjects   # where "New project" creates folders (default: <home>/HearthProjects)

# --- Model server (any OpenAI-compatible endpoint) ---
# HEARTH_LLM_BASE_URL=http://localhost:8080/v1
# HEARTH_LLM_MODEL=qwen3.6-35b-a3b
# HEARTH_LLM_API_KEY=local

# --- Tools ---
# HEARTH_LANGUAGETOOL_URL=http://localhost:8081
# GITHUB_TOKEN=github_pat_...

# --- Docker Compose only ---
# HEARTH_WORKSPACE=./workspace                                   # host folder mounted at /workspace
# HEARTH_LLM_BASE_URL_DOCKER=http://host.docker.internal:8080/v1
# HEARTH_LANGUAGETOOL_URL_DOCKER=http://host.docker.internal:8081
# VLLM_IMAGE_TAG=nightly
# VLLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
# VLLM_EXTRA_ARGS=--quantization modelopt
# VLLM_MAX_MODEL_LEN=65536
# VLLM_GPU_MEMORY_UTILIZATION=0.88
# HF_TOKEN=
